<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Sitio en GitHub Pages</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Encabezado -->
    <header>
        <h1>Mi Página Web en GitHub Pages</h1>
    </header>

    <!-- Sección principal -->
    <section class="principal">
        <div class="izquierda">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRDCsqRYLAFDdL4Ix_AHai7kNVyoPV9Ssv1xg&s" alt="Imagen principal">
            <p class="descripcion">Foto de ejemplo.</p>
        </div>

        <div class="derecha">
            <h2>Sección de Texto</h2>
            <p>
                Contenido que aparece al lado derecho de la imagen.
            </p>
        </div>
    </section>

    <!-- Galería -->
    <section class="galeria">
        <h2>Galería de Imágenes</h2>
        <div class="imagenes">
            <img src="https://humaneanimalrescue.org/wp-content/uploads/2019/08/community-cats-copy.jpg">
            <img src="https://www.alleycat.org/wp-content/uploads/2019/03/FELV-cat.jpg">
            <img src="https://t4.ftcdn.net/jpg/02/26/86/27/360_F_226862767_ht4s7N32LgT6ykC6IAiooQDUQ7hgiaaF.jpg">
        </div>
    </section>

    <!-- Sub sección -->
    <section class="subseccion">
        <div class="texto">
            <h3>Subtítulo de la Sección</h3>
            <p>
                Este texto que acompaña la imagen en esta sección.
            </p>
        </div>
        <div class="imagen">
            <img src="https://image.petmd.com/files/styles/978x550/public/2024-03/somali-cat.jpg" alt="Imagen secundaria">
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 Mi Sitio Web | Creado para GitHub Pages</p>
    </footer>

</body>
</html>
